{
	"name": "@henglosio/workflow",
	"version": "2.4.0",
	"description": "The HenglosIO workflow model and its real-time collaboration.",
	"author": "Henglos",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest",
		"prepublishOnly": "pnpm build"
	},
	"keywords": [
		"henglos",
		"henglosio",
		"workflow",
		"core"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsdown": "latest",
		"typescript": "^5.0.0",
		"vitest": "^4.1.6",
		"yjs": "13.6.33"
	},
	"dependencies": {
		"colord": "^2.9.3",
		"expr-eval": "^2.0.2",
		"nanoid": "^5.1.9",
		"uuid": "^13.0.0",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"yjs": "^13.6.0"
	},
	"module": "./dist/index.mjs"
}
