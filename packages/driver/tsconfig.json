{
	"ts-node": {
		"transpileOnly": true,
		"esm": true
	},
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],

		"paths": {
			"@/*": ["./src/*"]
		},		

		"sourceMap": true,
		"inlineSources": true,
		"declaration": false,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": ["src/**/*"]
}
