{
	"name": "@henglosio/ui",
	"version": "1.2.1",
	"description": "The HenglosIO design system: React components and tokens.",
	"author": "Henglos",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./globals.css": "./src/globals.css",
		"./tokens.css": "./src/tokens.css"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src/globals.css",
		"src/tokens.css"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "tsc -b --noEmit",
		"prepublishOnly": "pnpm build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"keywords": [
		"henglos",
		"henglosio",
		"ui",
		"react"
	],
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"gsap": ">=3",
		"lucide-react": ">=0",
		"radix-ui": ">=1",
		"react": ">=19",
		"react-dom": ">=19",
		"tailwindcss": ">=4"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.4.0",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/react-vite": "^10.4.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"gsap": "^3.15.0",
		"lucide-react": "^1.14.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"storybook": "^10.4.0",
		"tailwindcss": "^4.3.0",
		"tsdown": "latest",
		"typescript": "~6.0.2",
		"vite": "^8.0.10"
	}
}
