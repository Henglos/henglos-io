{
	"name": "@henglosio/hio-system",
	"version": "2.0.0",
	"description": "HenglosIO runtime for MicroPython boards.",
	"author": "Henglos",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"files": [
		"manifest.yaml",
		"hio/**/*.py",
		"henglosio/**/*.py",
		"main.py",
		"boot.py"
	],
	"scripts": {
		"test": "uv run --project . pytest -q test",
		"build:mpy": "uv run --project . python scripts/build.py",
		"prepack": "node scripts/bundle-sdk.mjs",
		"postpack": "node scripts/bundle-sdk.mjs --clean"
	}
}
