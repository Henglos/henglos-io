{
  "name": "henglosio",
  "version": "1.0.0",
  "description": "HenglosIO — build, flash and run workflows on microcontroller boards.",
  "author": "Henglos",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/check-majors.mjs",
    "release": "node scripts/check-majors.mjs && changeset publish --no-git-tag",
    "major": "node scripts/major.mjs",
    "check:majors": "node scripts/check-majors.mjs",
    "publish:dev": "node scripts/publish-dev.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "semver": "^7.8.5",
    "turbo": "^2.8.9"
  }
}
