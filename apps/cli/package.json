{
  "name": "@henglosio/cli",
  "version": "1.6.0",
  "description": "The HenglosIO command-line interface.",
  "author": "Henglos",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.mjs",
  "keywords": [
    "henglos",
    "henglosio",
    "iot",
    "workflow",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
