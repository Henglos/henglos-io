    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@hono/node-server": "^1.19.11",
    "@pybricks/mpy-cross-v6": "2.0.0",
    "axios": "^1.15.0",
    "commander": "^14.0.3",
    "consola": "3.4.2",
    "daemonize-process": "^4.1.1",
    "dockerode": "^4.0.10",
    "dotenv": "^17.4.2",
    "hono": "^4.12.22",
    "pacote": "^21.0.0",
    "reflect-metadata": "^0.2.2",
    "semver": "7.8.5",
    "serialport": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "4.2.6",
    "tar": "^7.5.13",
    "tsyringe": "^4.10.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@henglosio/driver": "workspace:*",
    "@henglosio/rfc2217": "workspace:*",
