HIO_HOST=...
HIO_PORT=...

HIO_DATABASE_PROVIDER=sqlite
HIO_DATABASE_URL=...


HIO_JWT_SECRET=...
HIO_USER_JWT_EXPIRATION=10d
HIO_DRIVER_JWT_EXPIRATION=30d


# The npm registry packages — and the platform — come from. Default: https://registry.npmjs.org/
# In development, the Gitea of docker-compose.dev.yaml: http://localhost:3000/api/packages/henglosio/npm/
# The drivers must use the same one (the same HIO_REGISTRY_URL).
HIO_REGISTRY_URL=...

# The monorepo's packages/ folder: its boards, components and platform are used
# instead of the registry's. Whatever isn't there still comes from the registry.
# HIO_LOCAL_PACKAGES=../../packages

# API requests a minute per client address (sign-in, register and driver pairing
# have tighter limits of their own). Default 600; 0 turns rate limiting off.
# HIO_RATE_LIMIT=600

# How many proxies sit in front (Caddy in the Docker setup: 1), so the rate limit
# sees the client's address and not the proxy's. Default 0: no proxy.
# HIO_TRUST_PROXY=0


# Anonymous telemetry — counts and versions, nothing anyone writes (docs/telemetry.md).
# On by default; HIO_TELEMETRY=false (or DO_NOT_TRACK=1) turns it off.
# In development, keep it off so your runs don't count as installations.
HIO_TELEMETRY=true
# Where events go — Henglos IO's PostHog project by default; set these only to
# send them somewhere else (e.g. a test project).
# HIO_TELEMETRY_KEY=phc_...
# HIO_TELEMETRY_HOST=https://eu.i.posthog.com
HIO_TELEMETRY_DEBUG=false


# The HenglosIO release this is — the release image sets it from its tag. Unset
# in development: the version is unknown and no update is announced.
# HIO_VERSION=1.7.0
# The studio's "a new version is available" alert: the hosting checks GitHub's
# tags every few hours (nothing about the installation is sent). On by default;
# HIO_UPDATE_CHECK=false turns it off.
# HIO_UPDATE_CHECK=true
