# Henglos IO — copy to .env and fill in.

# Where it's reached. A domain (hio.example.com) gets HTTPS from Let's Encrypt —
# its DNS must point here, and ports 80 and 443 be open. :80 serves plain HTTP.
HIO_SITE_ADDRESS=hio.localhost
# The host ports Caddy listens on.
HIO_HTTP_PORT=80
HIO_HTTPS_PORT=443

# Required. What sign-in tokens are signed with — generate one: openssl rand -hex 32
# Changing it signs everyone (and every driver) out.
HIO_JWT_SECRET=

# Required. What saved credentials are encrypted with — generate one: openssl rand -hex 32
# Keep it: changing it makes the saved credentials unreadable.
HIO_SECRETS_KEY=

# The Henglos IO version to run: the latest by default — `get-hio.sh --upgrade`
# (or docker compose pull && docker compose up -d) moves to the newest release.
# Set one (e.g. 1.2.0-beta) to stay on it.
# HIO_VERSION=latest

# The npm registry boards, components and the platform are installed from.
# The drivers must use the same one (their HENGLOS_REGISTRY).
HIO_REGISTRY_URL=https://registry.npmjs.org/

# Anonymous usage statistics — counts and versions, nothing anyone writes.
# false turns them off.
HIO_TELEMETRY=true
